    sn_trccbc(25)  =  'OBGC_RIVER_LOAD'  -12  'RIVERDON'  .false.  .true.  'yearly'  ''  ''  ''  
    sn_trccbc(26)  =  'OBGC_RIVER_LOAD'  -12  'RIVERDOP'  .false.  .true.  'yearly'  ''  ''  ''  
    sn_trccbc(21)  =  'OBGC_RIVER_LOAD'  -12  'RIVERDIC'  .false.  .true.  'yearly'  ''  ''  ''  
    sn_trccbc(22)  =  'OBGC_RIVER_LOAD'  -12  'RIVERDIC'  .false.  .true.  'yearly'  ''  ''  ''  
    rn_trcfac(2)   =  8.8464e+10         
