    cn_dir_sbc     =  './'               
    cn_dir_cbc     =  './'               
    cn_dir_obc     =  './'               
    ln_rnf_ctl     =  .true.             
    rn_sbc_time    =  86400.             
    rn_cbc_time    =  86400.             
/                  



